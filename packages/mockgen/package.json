{
  "name": "@arm/mockgen",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic mock-data generator: one airport day in AODB, AIDX and ACRIS formats, plus platform data.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "tsx src/cli.ts"
  },
  "dependencies": {
    "@arm/domain": "workspace:*"
  }
}
