# Copy to .env (next to this file) and adjust; the API reads it on start. Every value has a working default
# for the offline demo. Docker Compose reads the same file for the values it passes on (see compose.yaml).

# ---- server ----
PORT=3000
HOST=0.0.0.0
# Embedded PostgreSQL (no server needed), or a PostgreSQL server: postgres://arm:arm@localhost:5432/arm
DATABASE_URL=pglite:./.pglite/arm

# ---- simulation ----
SIM_DATE=2026-10-16
SIM_SEED=mqi
# Arrival/departure pairs per day (450 pairs = ~900 flights)
SIM_PAIRS=450
# Local time the simulation starts at and returns to on reset (13:50 = 20 min before the worked example).
SIM_START_TIME=13:50
# Local time the clock wraps to when the operating day ends (a long-running playground keeps going).
SIM_LOOP_START_TIME=05:00
# Initial speed (the UI offers 1x / 10x / 60x) and whether the clock starts playing.
SIM_SPEED=1
SIM_AUTOPLAY=true
# Fictional airport, fixed offset from UTC in minutes (+04:00)
AIRPORT_UTC_OFFSET_MINUTES=240
HOME_AIRPORT=MQI
CURRENCY=USD
DATA_DIR=./data/generated

# ---- data adapters: one value per source switches mock <-> live ----
FLIGHT_SOURCE=mock-aidx          # mock-aidx | vendor-api
SPACE_SOURCE=mock-acris          # mock-acris | ngsi-ld
AUDIENCE_SOURCE=mock-rules       # mock-rules | airline-api
# Live endpoints (only needed when the matching live adapter is selected)
# VENDOR_API_URL=https://aodb.example.com/api/
# VENDOR_API_TOKEN=
# NGSI_LD_URL=https://broker.example.com/
# NGSI_LD_TOKEN=
# AIRLINE_API_URL=https://airline.example.com/
# AIRLINE_API_TOKEN=
LIVE_POLL_INTERVAL_MS=15000
LIVE_TIMEOUT_MS=10000

# ---- promo QR codes ----
# Base URL a phone opens when scanning a promo QR: the laptop's LAN address locally
# (e.g. http://192.168.1.20:8080), the public URL on the playground.
# PUBLIC_BASE_URL=http://192.168.1.20:8080

# ---- AI ranking agent and creative assistant ----
# mock (offline, default) | openai-compatible | off (rule-based decisions only)
AI_PROVIDER=mock
# Any chat-completions API. OpenAI:
#   AI_API_URL=https://api.openai.com/v1/
#   AI_MODEL=gpt-4o-mini
# Google Gemini (OpenAI-compatible endpoint):
#   AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-2.5-flash
# AI_API_KEY=
AI_TIMEOUT_MS=8000

# ---- serving ----
# Express trust-proxy setting behind a reverse proxy (the frontend's Caddy on the Docker network: uniquelocal)
TRUST_PROXY=
# Docker Compose only: publish on all interfaces so phones on the LAN can open claim links
# BIND_ADDRESS=0.0.0.0
