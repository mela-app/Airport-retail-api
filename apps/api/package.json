{
  "name": "@arm/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend: REST + SSE API, adapters, simulation, presence and decision engine (NestJS).",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "perf": "tsx scripts/perf.ts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@arm/domain": "workspace:*",
    "@arm/mockgen": "workspace:*",
    "@electric-sql/pglite": "0.5.10",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1"
  }
}
